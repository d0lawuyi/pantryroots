# Copy to .env.local for `vercel dev`, and add the same names in Vercel → Settings → Environment Variables.

# Required: Meta Model API key (Muse Spark). Requests go to https://api.meta.ai/v1
META_API_KEY=

# Optional: override the model (default muse-spark-1.3, falls back to muse-spark-1.1)
# CONCIERGE_MODEL=muse-spark-1.3
# CONCIERGE_FALLBACK_MODELS=muse-spark-1.1

# Optional alternative: any OpenAI-compatible provider
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://api.meta.ai/v1

# Nearby shops + drive time (Google Cloud: enable Places API (New) and Routes API)
GOOGLE_MAPS_API_KEY=

# Real Instacart carts (Instacart Developer Platform). Without it, the cart card links to Instacart search.
INSTACART_API_KEY=
INSTACART_API_HOST=https://connect.dev.instacart.tools
