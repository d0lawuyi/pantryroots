# Copy to .env.local for `vercel dev`, and add the same names in Vercel → Settings → Environment Variables.

# Required for the AI concierge (Vercel → AI Gateway → API Keys)
AI_GATEWAY_API_KEY=

# Optional: any model AI Gateway offers, e.g. a Muse model if your credits are there
CONCIERGE_MODEL=anthropic/claude-opus-5

# Nearby shops + drive time (Google Cloud: enable Places API (New) and Routes API)
GOOGLE_MAPS_API_KEY=

# Real Instacart carts (Instacart Developer Platform). Without it, the cart card links to Instacart search.
INSTACART_API_KEY=
# Use https://connect.instacart.com once you have a production key
INSTACART_API_HOST=https://connect.dev.instacart.tools
